# API-Sports (api-football.com)
API_FOOTBALL_KEY=your_api_football_key

# RapidAPI - Transfermarkt (optional)
RAPIDAPI_KEY=your_rapidapi_key

# JWT Secret - generate a random string (min 32 chars)
JWT_SECRET=generate_a_random_secret_here_min_32_chars

# Admin key - for admin panel and sync endpoints
ADMIN_KEY=your_admin_key_here

# Sync token - for auto-sync cron job
SYNC_TOKEN=your_sync_token_here
